## @file
#  Collect and persist boot hotspots.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#
#  【中文說明】BootTimeHotspotDxe 是 DXE 驅動：在 ReadyToBoot 時收集各模組耗時，
#  排出「最慢前 N 名」並寫進 NVRAM（關機後仍保留）；若取不到細部資料，就改記大階段時間作為備案。
#
##

[Defines]
  INF_VERSION                    = 0x0001001A
  BASE_NAME                      = BootTimeHotspotDxe
  FILE_GUID                      = A1B2C3D4-E5F6-4789-A012-3456789ABCDE
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 0.1
  ENTRY_POINT                    = BootTimeHotspotDxeEntryPoint

[Sources]
  BootTimeHotspotDxe.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  BootTimeOptPkg/BootTimeOptPkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  UefiLib
  TimerLib
  BaseMemoryLib
  BaseLib
  DebugLib
  MemoryAllocationLib
  StackCheckLib
  PcdLib

[Guids]
  gEfiEndOfDxeEventGroupGuid
  gEfiEventReadyToBootGuid
  gEfiGlobalVariableGuid
  gBootTimeOptPkgVariableGuid
  gPerformanceExProtocolGuid

[Protocols]
  gEfiBootTimeMeasurementProtocolGuid

[Pcd]
  gBootTimeOptPkgTokenSpaceGuid.PcdBootTimeOptEnablePolicy
  gBootTimeOptPkgTokenSpaceGuid.PcdBootTimeOptEnableHotspot

[Depex]
  TRUE
