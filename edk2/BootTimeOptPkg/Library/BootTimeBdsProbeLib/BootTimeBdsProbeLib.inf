## @file
#  BDS checkpoint probes for boot-time breakdown.
#
#  【中文說明】這是「函式庫」的建置清單（.inf），不是執行邏輯本身。
#  告訴 EDK 建置系統：原始碼是 BootTimeBdsProbeLib.c，可被 DXE 驅動
#  與 UEFI 應用程式連結使用。真正計時程式在 .c 檔。
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x0001001A
  BASE_NAME                      = BootTimeBdsProbeLib
  FILE_GUID                      = 7C2E9A41-6B8D-4F1E-9C3A-5D8E2F4A1B70
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 0.1
  LIBRARY_CLASS                  = BootTimeBdsProbeLib|DXE_DRIVER UEFI_APPLICATION

[Sources]
  BootTimeBdsProbeLib.c

[Packages]
  MdePkg/MdePkg.dec
  BootTimeOptPkg/BootTimeOptPkg.dec

[LibraryClasses]
  BaseMemoryLib
  DebugLib
  TimerLib
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib

[Guids]
  gBootTimeOptPkgVariableGuid

[Protocols]
  gEfiBootTimeMeasurementProtocolGuid
