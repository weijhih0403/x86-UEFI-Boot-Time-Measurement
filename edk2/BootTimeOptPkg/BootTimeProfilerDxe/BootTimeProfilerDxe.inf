## @file
#  BootTimeProfilerDxe：開機計時驅動（DXE driver，沒有 main，由 ENTRY_POINT 指定的函式開始）。
#  在 EndOfDxe、ReadyToBoot、ExitBootServices 三個時間點讀硬體計時器（tick），
#  換算成奈秒後寫進 NVRAM（關機後仍保留的變數），再由 BootTimeDump 讀出。
#  本 .inf 描述模組的基本資訊、原始檔、相依套件、函式庫與 GUID。
##

[Defines]
  INF_VERSION                    = 0x0001001A
  BASE_NAME                      = BootTimeProfilerDxe
  FILE_GUID                      = 9F6B0965-DBD8-4A6D-B154-A5A055D6A785
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 0.1
  ENTRY_POINT                    = BootTimeProfilerDxeEntryPoint

[Sources]
  BootTimeProfilerDxe.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  BootTimeOptPkg/BootTimeOptPkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  DebugLib
  TimerLib
  BaseMemoryLib
  PrintLib
  SerialPortLib
  BootTimeBdsProbeLib

[Guids]
  gEfiEndOfDxeEventGroupGuid
  gEfiEventReadyToBootGuid
  gEfiEventExitBootServicesGuid
  gEfiGlobalVariableGuid
  gBootTimeOptPkgVariableGuid

[Protocols]
  gEfiBootTimeMeasurementProtocolGuid

[Depex]
  TRUE
